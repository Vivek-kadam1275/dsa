Solution 3: Optimal using binary search, with logn time complexity. square = (l+r)/2;
                                                                    if square==x then return exact mid;
                                                                    if square < x, make l=mid+1 and sqrt=mid;
                                                                    if square > x , make r=mid-1;

                                                                 after completing while loop return the sqrt

 class Solution {
    public int mySqrt(int x) {

        // using binary search

        if(x<2)
        {
            return x;
        }

        int l=1;
        int r=x;
        int sqrt=0;

        while(l<=r)
        {
            int mid=l+(r-l)/2;
            long square=(long) mid*mid;

            if(square==x)
            {
                return mid;
            }else if(square<x){
                l=mid+1;
                sqrt=mid;
            }else{
                r=mid-1;
            }

           
        }
         return sqrt;
        
    }
}



