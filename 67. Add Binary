Given two binary strings a and b, return their sum as a binary string.

 

Example 1:

Input: a = "11", b = "1"
Output: "100"
Example 2:

Input: a = "1010", b = "1011"
Output: "10101"
 

Constraints:

1 <= a.length, b.length <= 104
a and b consist only of '0' or '1' characters.
Each string does not contain leading zeros except for the zero itself.
 



Solution 1: BruteForce, by using two pointers  for maintaining digits of specific string & carry, 
class Solution {
    public String addBinary(String a, String b) {
            int i=a.length()-1;
            int j=b.length()-1;
            int carry=0;
            char digit;
            StringBuilder str=new StringBuilder("");
            while(i>=0 && j>=0)
            {
                int first=a.charAt(i)-48;
                int second=b.charAt(j)-48;
                int result=first+second+carry;
                if(result==3 )
                {
                    digit='1';
                    carry=1;
                }else if(result==2)
                {
                    digit='0';
                    carry=1;
                }else if(result==1)
                {
                    digit='1';
                    carry=0;
                }else
                {
                    digit='0';
                    carry=0;
                } 
                
                str.append(digit);
                i--;
                j--;
            }
            // System.out.println(str.toString());
            while(i>=0){
                int first=a.charAt(i)-48;
                int result=first+carry;
                if(result==2){
                    digit='0';
                    carry=1;
                }else if(result==1)
                {
                    digit='1';
                    carry=0;
                }else
                {
                    digit='0';
                    carry=0;
                } 
                str.append(digit);
                i--;
            }
            while(j>=0)
            {
                int second=b.charAt(j)-48;
                int result=second+carry;
                if(result==2){
                    digit='0';
                    carry=1;
                }else if(result==1)
                {
                    digit='1';
                    carry=0;
                }else
                {
                    digit='0';
                    carry=0;
                } 
                str.append(digit);
                j--;
            }
            if(carry==1)
            {
                str.append('1');
            }
            // System.out.println(str.toString());
            return str.reverse().toString();
    }
}


Solution 2: 
class Solution {
    public String addBinary(String a, String b) {
            int i=a.length()-1;
            int j=b.length()-1;
            int carry=0;
            int digit;
            StringBuilder str=new StringBuilder("");
            while(i>=0 || j>=0 || carry!=0)
            {

                int result=0;
                if(i>=0)
                {
                     int first=a.charAt(i)-48;
                     result+=first;
                     i--;
                }
               
               if(j>=0)
               {
                    int second=b.charAt(j)-48;
                    result+=second;
                    j--;
               }
               
                result+=carry;

                digit=result%2;
                carry=result/2;
                str.append(digit);   
            }
            
            return str.reverse().toString();
    }
}
